# Copy to .env. Never commit the real .env or data directory.
SITE_URL=https://music.example.com
PRODUCTION=1
TRUST_PROXY=1
DATA_DIR=data
# Run python manage.py setup to create the private author URL and password.
# SMTP stays disabled until a real host and sender are configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TEST_TO=
MAIL_INTERVAL_SECONDS=3
